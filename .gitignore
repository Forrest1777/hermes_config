# =============================================================================
# Hermes environment repository
# Repository root: E:\dev\ai_agents\hermes
#
# Purpose:
#   Version only static files that explain/configure the Hermes environment.
#   Exclude runtime state, logs, databases, caches, workspaces, backups and
#   duplicated/generated copies.
#
# All paths below are RELATIVE to the repository root.
# =============================================================================

# -----------------------------------------------------------------------------
# DENY EVERYTHING AT ROOT BY DEFAULT
# -----------------------------------------------------------------------------
/*

# Repository metadata/docs
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/LICENSE

# -----------------------------------------------------------------------------
# TOP-LEVEL LEGACY / MAINTENANCE SCRIPTS
# -----------------------------------------------------------------------------
!/backup-hermes.bat
!/backup-kanban.bat
!/restore-kanban.bat

# -----------------------------------------------------------------------------
# COMPOSE
# Keep Docker/Compose configuration and related static helper files.
# Secrets such as .env are re-ignored later.
# -----------------------------------------------------------------------------
!/compose/
!/compose/**

# -----------------------------------------------------------------------------
# TOOLs
# Operational/audit scripts maintained by the user.
# Generated logs, archives, DBs and caches are re-ignored later.
# -----------------------------------------------------------------------------
!/TOOLs/
!/TOOLs/**

# -----------------------------------------------------------------------------
# HERMES DATA
# -----------------------------------------------------------------------------
!/hermes-data/

# Deny every direct child first, then explicitly reopen useful static content.
/hermes-data/*

# Core behavior/configuration
!/hermes-data/SOUL.md
!/hermes-data/config.yaml
!/hermes-data/gitconfig
!/hermes-data/.env.example

# -----------------------------------------------------------------------------
# PROFILES
#
# Keep profile behavior/configuration, but NOT duplicated skill contents.
# skills/.bundled_manifest is retained to preserve which bundle/version was
# installed for each profile without storing hundreds of copied skill files.
# -----------------------------------------------------------------------------
!/hermes-data/profiles/

# Ignore all immediate profile entries first.
/hermes-data/profiles/*

# Re-open profile directories only (not extracted duplicate files sitting
# directly under profiles/).
!/hermes-data/profiles/*/

# Ignore everything inside each profile by default.
/hermes-data/profiles/*/**

# Canonical profile definition
!/hermes-data/profiles/*/SOUL.md
!/hermes-data/profiles/*/config.yaml
!/hermes-data/profiles/*/profile.yaml
!/hermes-data/profiles/*/.env.example

# Preserve installed skill bundle identity per profile, but not the copies.
!/hermes-data/profiles/*/skills/
!/hermes-data/profiles/*/skills/.bundled_manifest

# Profile-specific operational scripts are static behavior.
!/hermes-data/profiles/*/scripts/
!/hermes-data/profiles/*/scripts/**

# Execution Governor: only active static policy.
!/hermes-data/profiles/execution-governor/governance/
!/hermes-data/profiles/execution-governor/governance/policy.yaml

# Maintenance scripts stored directly in profiles/
!/hermes-data/profiles/EXTRACT_PROFILE.bat
!/hermes-data/profiles/IMPORT_PROFILE.bat

# -----------------------------------------------------------------------------
# CANONICAL ROOT SKILLS
#
# Keep only the behavior contract (SKILL.md) for generic skills.
# Do not store duplicated profile copies, references, examples or helper code
# unless explicitly whitelisted below.
# -----------------------------------------------------------------------------
!/hermes-data/skills/

# Ignore all skill content first.
/hermes-data/skills/**

# Re-open directories so selected files can be included.
!/hermes-data/skills/**/

# Main skill behavior definition.
!/hermes-data/skills/**/SKILL.md

# Installed bundle inventory/version metadata.
!/hermes-data/skills/.bundled_manifest

# Selected operational skills whose implementation materially affects this
# Hermes workflow. Keep these complete.
!/hermes-data/skills/caveman-caveman-compress/**
!/hermes-data/skills/worktree-preflight/**

# -----------------------------------------------------------------------------
# CENTRALIZED PLUGINS
#
# This is the canonical plugin location for this environment.
# Keep plugin source/manifests/tests/docs; generated Python caches are ignored.
# Do not keep plugin copies from profiles or dependency caches.
# -----------------------------------------------------------------------------
!/hermes-data/plugins/
!/hermes-data/plugins/**

# -----------------------------------------------------------------------------
# HERMES STATIC SCRIPTS
# -----------------------------------------------------------------------------
!/hermes-data/scripts/
!/hermes-data/scripts/**

# Small static wrappers maintained in hermes-data/bin.
# Large installed binaries (rtk, tirith, uv, etc.) are intentionally excluded.
!/hermes-data/bin/
!/hermes-data/bin/godot-lsp-bridge
!/hermes-data/bin/kanban-online-backup.py

# -----------------------------------------------------------------------------
# OPERATIONAL HARDENING / PATCH MATERIAL
#
# Keep current hardening source, policy templates and documentation.
# Historical backup directories are not reopened.
# -----------------------------------------------------------------------------
!/hermes-data/operational-hardening/
!/hermes-data/operational-hardening/**

# =============================================================================
# GLOBAL RE-IGNORE RULES INSIDE ALLOWED TREES
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETS / CREDENTIALS
# -----------------------------------------------------------------------------
**/.env
**/auth.json
**/auth.lock
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt

# Sanitized templates remain allowed.
!/.env.example
!/compose/.env.example
!/hermes-data/.env.example
!/hermes-data/profiles/*/.env.example

# -----------------------------------------------------------------------------
# DATABASES / MUTABLE STATE
# -----------------------------------------------------------------------------
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*-wal
**/*-shm

# -----------------------------------------------------------------------------
# LOGS / SESSIONS / RUNTIME TRACES
# -----------------------------------------------------------------------------
**/*.log
**/*.log.*
**/*.jsonl
**/.hermes_history
**/logs/
**/sessions/
**/terminal-sessions/
**/spawn-trees/
**/forensics/
**/recovery/
**/cron/
**/state/

# -----------------------------------------------------------------------------
# GOVERNOR / RUNTIME STATE
# -----------------------------------------------------------------------------
**/governance/cases/
**/governance/events*
**/governance/state.json
**/governance/*.lock
**/governance-evidence-before-*/
**/.events.jsonl.lock
**/.state.json.lock

# Re-allow the static Governor policy after runtime rules.
!/hermes-data/profiles/execution-governor/governance/policy.yaml

# -----------------------------------------------------------------------------
# LOCKS / PIDS / RUNTIME MARKERS
# -----------------------------------------------------------------------------
**/*.lock
**/*.pid
**/.clean_shutdown
**/.mcp-discovery.lock
**/.codex_gpt55_autoraise_notice
**/.scratch_tip_shown

# -----------------------------------------------------------------------------
# CACHES / GENERATED MODEL METADATA
# -----------------------------------------------------------------------------
**/.cache/
**/cache/
**/models_dev_cache.json
**/models_dev_cache.etag
**/provider_models_cache.json
**/ollama_cloud_models_cache.json
**/context_length_cache.yaml
**/.skills_prompt_snapshot.json
**/channel_directory.json
**/gateway_state.json
**/gateway-starts.log
**/tui-theme-boot.json

# Skills Hub / Curator mutable state
**/.hub/
**/.curator_backups/
**/.curator_state
**/.usage.json
**/.usage.json.lock
**/graphify.backup/
**/broken-root-symlinks-*.txt
**/*install-report*.txt

# Keep bundled manifests despite generic skill/runtime filtering.
!/hermes-data/skills/.bundled_manifest
!/hermes-data/profiles/*/skills/.bundled_manifest

# -----------------------------------------------------------------------------
# LANGUAGE / PACKAGE MANAGER DEPENDENCIES
# -----------------------------------------------------------------------------
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/site-packages/
**/node_modules/
**/.npm/
**/.local/
**/uv/
**/lsp/
**/lazy-packages/

# -----------------------------------------------------------------------------
# BACKUPS / TEMPORARY / OLD COPIES
# -----------------------------------------------------------------------------
**/backups/
**/.operational-hardening-backup-*/
**/.dirty-checkpoint-recovery-backup-*/
**/.dirty-checkpoint-recovery-v2-backup-*/
**/logs_before_governor_*/
**/*.bak
**/*.bak-*
**/*.bak.*
**/*_BKP.*
**/*.before-*
**/*.corrupt.*
**/*.tmp
**/*.tmp.*
**/*~
**/*.swp
**/*.swo

# -----------------------------------------------------------------------------
# ARCHIVES / GENERATED BUNDLES
# -----------------------------------------------------------------------------
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.gz
**/*.7z
**/*.rar

# -----------------------------------------------------------------------------
# LARGE / INSTALLED BINARIES
# -----------------------------------------------------------------------------
**/*.so
**/*.dll
**/*.dylib
**/*.exe
**/*.bin
**/*.dat

# Known installed binaries under hermes-data/bin
/hermes-data/bin/rtk
/hermes-data/bin/tirith

# -----------------------------------------------------------------------------
# MEDIA / NON-TEXTUAL ASSETS
# Generally not useful for GPT operational inspection.
# -----------------------------------------------------------------------------
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.pdf

# -----------------------------------------------------------------------------
# NESTED GIT INTERNALS
# -----------------------------------------------------------------------------
**/.git/

# =============================================================================
# TOP-LEVEL DIRECTORIES INTENTIONALLY EXCLUDED
#
# These remain ignored because /* denies them and they are never reopened:
#
# /backups/
# /logs/
# /teste/
# /workspace/
# =============================================================================

# ============================================================================
# FINAL OVERRIDES — problematic Linux links/binaries
# These rules must remain at the END of this file.
# ============================================================================

/hermes-data/bin/*
!/hermes-data/bin/godot-lsp-bridge
!/hermes-data/bin/kanban-online-backup.py

/hermes-data/bin/graphify
/hermes-data/bin/graphify-mcp
/hermes-data/skills/graphify/
