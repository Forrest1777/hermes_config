DIRTY_RECOVERY_TOOLSET = "orchestration_control"
DIRTY_RECOVERY_ALLOWED_TARGET_PROFILES = {"implementation-worker", "implementation-architect"}

DIRTY_RECOVERY_SCHEMA = {
